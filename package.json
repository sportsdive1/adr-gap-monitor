{
  "name": "adr-gap-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "pnpm test && pnpm build && pnpm test:browser"
  },
  "devDependencies": {
    "wrangler": "4.112.0",
    "playwright": "1.62.1"
  }
}
